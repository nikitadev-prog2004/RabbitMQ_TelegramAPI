# RabbitMQ (общий для producer и consumer)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=notification_events
RABBITMQ_PREFETCH=10

# Producer (отдельный ключ — в одном .env нельзя два раза задавать PORT)
PRODUCER_PORT=3001
RABBITMQ_PUBLISH_RETRIES=5
RABBITMQ_PUBLISH_RETRY_DELAY_MS=200

# Consumer
HTTP_PORT=3002
TELEGRAM_SERVICE_URL=http://localhost:3003
CONSUMER_MAX_RETRIES=5
IDEMPOTENCY_MAX_ENTRIES=50000
# Идемпотентность в Redis (несколько инстансов consumer). Локально: redis://127.0.0.1:6379
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_IDEMPOTENCY_TTL_SECONDS=604800
# Режим авто-подтверждения RabbitMQ (только отладка: без ручного ack/nack, при падении — риск потери)
# CONSUMER_RMQ_AUTO_ACK=false

# Telegram-сервис
TELEGRAM_PORT=3003
TELEGRAM_BOT_TOKEN=000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
TELEGRAM_CHAT_ID=000000000
# Удалённый HTTP-прокси (Astrill и т.п.) — логин/пароль отдельно от хоста:
# TELEGRAM_PROXY_HOST=1.2.3.4
# TELEGRAM_PROXY_PORT=8000
# TELEGRAM_PROXY_USER=myuser
# TELEGRAM_PROXY_PASSWORD=mypass
# Локальный Clash (если LISTENING на 127.0.0.1):
# TELEGRAM_HTTPS_PROXY=http://127.0.0.1:7890
# TELEGRAM_HTTPS_PROXY=socks5://127.0.0.1:7891
# Если до api.telegram.org ETIMEDOUT и прокси нет — успешный ответ API без реальной отправки (только для разработки):
# TELEGRAM_MOCK_SEND=true
# Таймаут HTTP к api.telegram.org (мс)
# TELEGRAM_HTTP_TIMEOUT_MS=30000
