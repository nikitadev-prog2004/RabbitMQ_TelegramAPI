{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testMatch": ["**/*.integration.spec.ts"],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testTimeout": 120000,
  "moduleNameMapper": {
    "^@notification/contracts$": "<rootDir>/../../../packages/contracts/src/index.ts"
  }
}
